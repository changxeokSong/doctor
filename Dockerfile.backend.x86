# Django + app/ GPU 백엔드 - 일반 x86_64 + 표준 NVIDIA GPU 서버용 (Dockerfile.backend는 DGX Spark
# arm64 전용 NGC 이미지라 여기선 못 씀). 베이스 이미지에 torch+CUDA가 이미 맞춰져 있어
# requirements.txt에 torch를 안 넣는다(재설치 시 CPU 전용 wheel로 덮어쓸 위험).
FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

WORKDIR /srv

# kiwipiepy 등 일부 패키지가 빌드 도구를 필요로 할 수 있어 미리 설치.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

# 모델·캐시·코퍼스·로그는 이미지에 안 굽고 docker-compose.yml에서 마운트(이미지 크기 최소화).
COPY app/ ./app/
COPY backend/ ./backend/

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

# config.py의 상대경로가 저장소 루트(=/srv) 기준이라 CWD를 /srv로 유지해야 한다.
CMD ["python", "backend/manage.py", "runserver", "0.0.0.0:8000"]
