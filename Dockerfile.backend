# Django + app/(분류·검색·키워드추출·표제어매핑) GPU 백엔드.
# NVIDIA DGX Spark(GB10, arm64/sm_121) 전용 - NGC 공식 이미지가 arm64+Blackwell 커널 포함 torch를
# 이미 갖고 있어 이걸 쓴다(일반 pip torch wheel은 이 조합을 지원 안 함, requirements.txt에 torch 없음).
FROM nvcr.io/nvidia/pytorch:25.11-py3

WORKDIR /srv

# kiwipiepy 등 일부 패키지가 빌드 도구를 필요로 할 수 있어 미리 설치.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

# 모델·캐시·코퍼스·로그는 이미지에 안 굽고 docker-compose.yml에서 마운트(이미지 크기 최소화).
COPY app/ ./app/
COPY backend/ ./backend/

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

# config.py의 상대경로가 저장소 루트(=/srv) 기준이라 CWD를 /srv로 유지해야 한다.
CMD ["python", "backend/manage.py", "runserver", "0.0.0.0:8000"]
